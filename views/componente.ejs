<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= item.nome %> | Portal da Eletrônica</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include('partials/header') %>

  <main>
    <section class="detail"><a class="back" href="/catalogo">← Voltar ao catálogo</a>
      <div class="detail-grid">
        <div>
          <p class="eyebrow dark"><%= item.categoria.toUpperCase() %> / GUIA DO COMPONENTE</p>
          <h1><%= item.nome %><span class="accent">.</span></h1>
          <p class="detail-lead"><%= item.descricao %></p>
        </div>
        <div class="detail-art detail-photo">
          <img src="<%= item.imagem %>" alt="<%= item.imagemAlt %>">
        </div>
      </div>
      <div class="detail-content">
        <div>
          <p class="eyebrow dark">ENTENDA O COMPONENTE</p>
          <h2>Como funciona<span class="accent">.</span></h2>
        </div>
        <div>
          <p><%= item.texto %></p>
          <section class="component-video" aria-labelledby="video-title">
            <h3 id="video-title">Vídeo explicativo</h3>
            <video controls preload="metadata" playsinline>
              <source src="<%= item.video %>" type="video/mp4">
              <track kind="captions" src="<%= item.legenda %>" srclang="pt-BR" label="Português (Brasil)" default>
              Seu navegador não suporta a reprodução de vídeo.
            </video>
          </section>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>

</html>